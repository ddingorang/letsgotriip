# 루트 docker-compose 변수 치환용 — 이 파일을 .env 로 복사하고 실제 값을 채우세요.
# .env 는 커밋 금지(시크릿). compose 가 ${VAR} 형태로 아래 값들을 읽어 주입합니다.

# ── 백엔드 시크릿 ─────────────────────────────────────────────────────────────

# JWT 서명 키 — 외부 노출 금지. 생성 예: openssl rand -base64 32
JWT_SECRET=

# SSAFY GMS (OpenAI 호환 — chat / Whisper STT 공용 키)
OPENAI_API_KEY=

# 한국관광공사 TourAPI — 디코딩된 일반 인증키
TOUR_API_KEY=

# Google OAuth2 (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 프론트엔드 빌드 ARG ───────────────────────────────────────────────────────

# 카카오 지도 JavaScript 키 — 핫플 등록/지도 표시용.
# frontend 이미지 빌드 시 ARG 로 주입됨(미입력 시 지도 기능만 비활성, 빌드는 성공).
VITE_KAKAO_MAP_KEY=

# 데모 로그인 프리필 — 값을 채우면 로그인 폼이 미리 채워짐(데모 편의).
# 미설정 시 compose 기본값(demo@triip.com / demo1234)으로 채워짐.
# 운영처럼 빈칸을 원하면 아래를 '빈 값'으로 명시 지정: VITE_DEMO_EMAIL=
#VITE_DEMO_EMAIL=
#VITE_DEMO_PASSWORD=
