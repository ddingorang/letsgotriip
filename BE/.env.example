# 이 파일을 .env로 복사하고 실제 값을 채우세요. .env는 gitignore 대상입니다.
# 주의: 2026-06 이전에 커밋됐던 JWT secret은 노출됐으므로 재사용 금지 (반드시 새로 생성)
#   생성: openssl rand -base64 32

# JWT
JWT_SECRET=

# Google OAuth2 (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 한국관광공사 TourAPI (디코딩된 일반 인증키)
TOUR_API_KEY=

# SSAFY GMS (OpenAI 호환 — chat/STT 공용)
OPENAI_API_KEY=

# DB (로컬 docker-compose 기본값이면 생략 가능)
#DB_USERNAME=root
#DB_PASSWORD=password
#RABBITMQ_USERNAME=guest
#RABBITMQ_PASSWORD=guest

# 채팅 도메인 끄고 부팅 (RabbitMQ 없이)
#CHAT_ENABLED=false

# FE OAuth 콜백 (기본 http://localhost:5173/oauth/callback)
#FE_OAUTH_CALLBACK_URL=
