# Created: 2026-06-16 13:36:13

# ── API base URL ────────────────────────────────────────────────────────────────
# 개발(npm run dev)에서는 비워 두세요. 빈 값이면 axios baseURL=''(src/api/http.js)이
# 되어 Vite dev 프록시(vite.config.js)가 /api·/auth·/users 등을 :9090 으로 라우팅합니다.
# 프로덕션 빌드에서는 .env.production 에서 BE(또는 리버스 프록시) origin 을 지정하세요.
VITE_API_BASE_URL=

# ── 카카오 지도 JavaScript 키 ────────────────────────────────────────────────────
# 핫플 등록/지도 표시에 사용. 카카오 개발자센터에서 발급한 JS 키를 입력하세요.
VITE_KAKAO_MAP_KEY=

# ── 데모 로그인 프리필 (선택) ─────────────────────────────────────────────────────
# 값을 채우면 로그인 화면에 이메일/비밀번호가 미리 입력됩니다(데모 편의).
# 비어있으면 빈칸으로 표시됩니다. 운영 빌드에서는 비워 두세요.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
